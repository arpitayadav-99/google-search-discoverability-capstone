# Copy to .env and fill in — NEVER commit .env
# Both are optional; project runs on starter CSV without them.

# Hugging Face token for gated FlyRank warehouse
HF_TOKEN=YOUR_HF_TOKEN_HERE

# Full warehouse URI (leave as default unless release path changes)
FLYRANK_WAREHOUSE_URI=hf://datasets/FlyRank/internship-warehouse/fact_content_daily_performance/**/*.parquet
